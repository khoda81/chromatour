{
  "name": "chromatour",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run wasm:build:dev && vite",
    "build": "bun run wasm:build && bun run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "bun test",
    "wasm:build:dev": "cd crates/chromatour-core && wasm-pack build --dev --target web --out-dir ../../src/wasm/pkg",
    "wasm:build": "cd crates/chromatour-core && wasm-pack build --release --target web --out-dir ../../src/wasm/pkg",
    "wasm:clean": "rm -rf src/wasm/pkg"
  },
  "dependencies": {
    "plotly.js-basic-dist-min": "3.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
